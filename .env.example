# KAELON ortam değişkenleri.
#
# Üretimde eksik veya bozuk ayar sunucuyu BAŞLATMAZ (bkz. instrumentation.ts).
# Geliştirmede uyarı verilip devam edilir.

# Kontrol düzlemi: tenant, kullanıcı, oturum, kullanım defteri.
SHARED_DATABASE_URL="postgresql://kullanici@localhost:5432/kaelon?schema=shared"

# Tenant şemaları. Şablon şema; her tenant kendi şemasına yönlendirilir.
TENANT_DATABASE_URL="postgresql://kullanici@localhost:5432/kaelon?schema=tenant_template"

# Model bağlantısı. ÜRETİMDE ZORUNLU.
ANTHROPIC_API_KEY=""

# Çalışma alanı kimliği.
#
# KİMLİĞE BAĞLI (identity-linked) API anahtarları bunu ZORUNLU tutar:
# anahtar tek başına hangi çalışma alanında işlem yapıldığını söylemez ve
# sunucu isteği 400 ile "anthropic-workspace-id is required" diyerek
# reddeder. Normal anahtarlarda boş bırakılır.
#
# Değeri console.anthropic.com → Settings → Workspaces altında bulunur.
# ANTHROPIC_WORKSPACE_ID=""

# AI harcama tavanı — KULLANICI BAŞINA, AYLIK, USD.
#
# İki kademe: yumuşak eşikte pahalı işler durur, okuma sürer; TAVANDA
# hiçbir model çağrısı yapılmaz. Kredisi sınırlı bir kurulumda tavanı
# düşürmek kod değişikliği gerektirmemelidir.
# KAELON_AI_WARN_USD="1.5"
# KAELON_AI_SOFT_CAP_USD="2.0"
# KAELON_AI_CAP_USD="5.0"

# Üretimde model olmadan açılmaya AÇIK İZİN. Yalnızca "1" değeri kabul edilir.
# Sistem sessizce demo moduna DÜŞMEZ; operatör bilerek SEÇER ve loglanır.
# KAELON_ALLOW_DEMO_MODE=1
