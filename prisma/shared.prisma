// KAELON kontrol düzlemi (control plane).
//
// Bu şema TÜM tenant'lar için ortaktır ve yalnızca kiracı kaydı, kullanıcı
// kimliği ve faturalama/kullanım verisi tutar. İşletmesel veri BURAYA GİRMEZ —
// o her tenant'ın kendi şemasındadır (bkz. prisma/tenant.prisma).
//
// Ayrım kritiktir: KVKK silme talebi bir tenant şemasının DROP'u ile karşılanır;
// kontrol düzlemi bundan etkilenmez.

generator client {
  provider = "prisma-client-js"
  output   = "../src/db/generated/shared"
}

datasource db {
  provider = "postgresql"
  url      = env("SHARED_DATABASE_URL")
}

/**
 * Demo talebi — ürünü denemek isteyen kişinin bıraktığı bilgi.
 *
 * NEDEN TENANT'TAN AYRI: iletişim bilgisi KİŞİSEL VERİDİR ve
 * işletmesel veriyle aynı yerde durmamalı. Tenant silindiğinde bu
 * kayıt bir süre daha kalır (satış takibi), ama tersi de mümkün
 * olmalı: kişi "bilgimi silin" derse tenant'a dokunmadan silinir.
 *
 * AÇIK RIZA KAYDA GEÇER. KVKK açısından "form dolduruldu" yetmez;
 * onayın hangi metne, ne zaman verildiği saklanır.
 */
model DemoRequest {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @map("company_name")
  /// Ticari unvan — faturanın anteti. Şirket adından farklı olabilir.
  legalName     String?  @map("legal_name")
  /// VKN ve vergi dairesi: e-Faturanın zorunlu alanları. Girilmezse
  /// demo fatura üretebilir ama alanlar örnek değerle dolar.
  taxId         String?  @map("tax_id")
  taxOffice     String?  @map("tax_office")
  city          String?
  sector        String
  employeeBand  String   @map("employee_band")
  /// Açılış bilançosunun ölçeğini belirler.
  revenueBand   String?  @map("revenue_band")
  /// "yok" | "EUR" | "USD" — dövizli fatura ve kur değerlemesi
  /// yalnızca ihracatçıda kurulur.
  exportCurrency String? @map("export_currency")
  /// Şu an ne kullanıyor: excel | logo | mikro | netsis | sap | diger
  currentSystem String?  @map("current_system")
  goals         String
  contactName   String   @map("contact_name")
  /// Görev — ajan "kim soruyor" bilgisini buradan alır.
  contactTitle  String?  @map("contact_title")
  contactEmail  String   @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  /// Açık rıza: hangi metne, ne zaman.
  consentText   String   @map("consent_text")
  consentAt     DateTime @map("consent_at")
  /// Kötüye kullanımı sınırlamak için — ham IP değil, tuzlanmış özet.
  clientHash    String   @map("client_hash")
  /// Kurulan tenant. Kurulum başarısız olursa null kalır ve talep
  /// yine kaydedilir — başarısız denemeler de bilgidir.
  tenantId      String?  @map("tenant_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([clientHash, createdAt])
  @@index([contactEmail])
  @@map("demo_requests")
}

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  /// Bu tenant'ın işletmesel verisinin yaşadığı Postgres şeması.
  schemaName   String   @unique @map("schema_name")
  locale       String   @default("tr-TR")
  baseCurrency String   @default("TRY") @map("base_currency")
  status       TenantStatus @default(provisioning)

  /*
   * ŞİRKET PROFİLİ — AJANIN BAĞLAMI.
   *
   * Ajan "hangi şirkette çalıştığını" bilmeden cevap verirse, cevap
   * genel geçer olur: bir dökümhaneye tekstil örneği verir, bir
   * ihracatçıya kur riskinden hiç söz etmez. Sektör ve öncelikler
   * oturum bağlamına giriyor ve cevabın tonunu belirliyor.
   *
   * VERİ DEĞİL, BAĞLAM. Buradaki bilgi hiçbir hesaba girmez ve hiçbir
   * yetkiyi genişletmez; yalnızca modelin neye dikkat edeceğini
   * söyler. Yanlış girilmiş bir sektör yanlış rakam üretmez.
   */
  sector       String?
  /// Şirketin kendi ifadesiyle öncelikleri. Serbest metin.
  goals        String?
  /*
   * ŞU AN NE KULLANIYOR.
   *
   * Ajanın cevabını değiştirir: SAP'den geçen birine "bu SAP'deki
   * KE30 raporunun karşılığı" demek işe yarar; Excel'den gelene aynı
   * cümle hiçbir şey ifade etmez.
   */
  currentSystem String? @map("current_system")
  /// "yok" | "EUR" | "USD" — ihracatçıda kur riski öne çıkar.
  exportCurrency String? @map("export_currency")

  /*
   * DEMO TENANT'LARI KENDİLİĞİNDEN ÖLÜR.
   *
   * Süresiz bir demo, aylar sonra kimsenin sahiplenmediği gerçek
   * kişisel veri taşıyan bir şemadır. `expiresAt` geçince şema
   * düşürülür ve iletişim bilgisi silinir.
   */
  isDemo       Boolean  @default(false) @map("is_demo")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  usage       AiUsage[]

  @@map("tenants")
}

enum TenantStatus {
  provisioning
  active
  suspended
  archived
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  passwordHash String?  @map("password_hash")
  totpSecret   String?  @map("totp_secret")
  /// Kabul edilen son TOTP zaman adımı — aynı kodun tekrar kullanımını engeller.
  lastTotpStep BigInt?  @map("last_totp_step")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships    Membership[]
  sessions       Session[]
  passwordResets PasswordReset[]

  @@map("users")
}

/// Kullanıcı ↔ tenant ilişkisi ve o tenant'taki rolleri.
/// Bir kullanıcı birden çok tenant'ta farklı rollerde olabilir.
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// RoleId değerleri (src/kernel/types.ts) — örn. ["patron"]
  roles     String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// AI Usage Ledger — tenant ve kullanıcı bazında token/maliyet.
/// Bütçe kapısı (uyarı 1,5 USD, cap 2 USD) bu tablodan beslenir.
model AiUsage {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  correlationId    String   @map("correlation_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @map("cache_read_tokens")
  cacheWriteTokens Int      @map("cache_write_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@map("ai_usage")
}

/// Başarısız giriş sayacı.
///
/// Kullanıcı tablosunda DEĞİL, e-posta anahtarıyla ayrı tablodadır: var
/// olmayan bir e-postaya yapılan deneme de sayılmalıdır, aksi hâlde kaba
/// kuvvet saldırısı önce geçerli e-postayı bulup sonra sınırsız dener.
model LoginAttempt {
  email         String    @id
  count         Int       @default(0)
  lockedUntil   DateTime? @map("locked_until")
  lastFailureAt DateTime  @default(now()) @map("last_failure_at")

  @@index([lockedUntil])
  @@map("login_attempts")
}

/// Parola sıfırlama kodu — YÖNETİCİ BAŞLATIR.
///
/// E-posta altyapısı yok ve olmayan altyapıya karşı kod yazmak, test
/// edilemeyen ve ilk kurulumda yanlış çıkan kod yazmaktır. Bunun yerine
/// akış Türk KOBİ gerçeğine göre kuruldu: kullanıcı yöneticiyi arar,
/// yönetici tek kullanımlık bir kod üretir ve sözlü/telefonla iletir.
///
/// KOD HASH'LENEREK SAKLANIR. Veritabanı sızarsa saklanan değerle parola
/// sıfırlanamaz — parolayı hash'leyip sıfırlama kodunu düz saklamak,
/// arka kapıyı açık bırakmaktır.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  /// Kullanıldığı an. Tek kullanımlık olmasını bu alan sağlar.
  usedAt    DateTime? @map("used_at")
  /// Kodu üreten yönetici — denetim izi.
  issuedBy  String?   @map("issued_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}
