{
  "name": "kaelon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KAELON — AI-Native Operasyonel İşletim Sistemi",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/.bin/vitest run",
    "test:watch": "node --env-file-if-exists=.env node_modules/.bin/vitest",
    "db:generate": "prisma generate --schema=prisma/shared.prisma && prisma generate --schema=prisma/tenant.prisma",
    "db:push": "prisma db push --schema=prisma/shared.prisma && prisma db push --schema=prisma/tenant.prisma",
    "db:ddl": "prisma migrate diff --from-empty --to-schema-datamodel prisma/tenant.prisma --script > prisma/tenant-template.sql",
    "verify": "npm run typecheck && npm test",
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "eval": "node --env-file-if-exists=.env --import tsx src/eval/run.ts",
    "user": "node --env-file-if-exists=.env --import tsx src/scripts/user.ts",
    "tenant": "node --env-file-if-exists=.env --import tsx src/scripts/tenant.ts",
    "verify:full": "npm run typecheck && npm test && npm run build",
    "audit": "node --env-file-if-exists=.env --import tsx src/scripts/audit.ts",
    "usage": "node --env-file-if-exists=.env --import tsx src/scripts/usage.ts",
    "demo:data": "node --env-file-if-exists=.env --import tsx src/scripts/demo-data.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx src/scripts/smoke.ts",
    "demo:prune": "node --env-file-if-exists=.env --import tsx src/scripts/demo-prune.ts",
    "setup": "node --env-file-if-exists=.env --import tsx src/scripts/setup-tenant.ts",
    "seed:uls": "node --env-file-if-exists=.env --import tsx src/scripts/seed-uls.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superjson": "^2.2.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
